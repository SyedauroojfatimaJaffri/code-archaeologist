# ==========================================
# Code Archaeologist - Environment Configuration
# ==========================================
# Copy this file to .env and provide your credentials.
# NEVER commit .env to version control.

# Application Settings
APP_NAME=Code Archaeologist
DEBUG=false
API_PREFIX=

# Database Configuration (Supabase PostgreSQL + pgvector)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/code_archaeologist
AUTO_CREATE_TABLES=true
EMBEDDING_DIMENSIONS=1536

# Supabase Authentication & Client
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AI & LLM (Groq)
GROQ_API_KEY=your-groq-api-key-here

# GitHub Integration (Optional for public repos, recommended to prevent rate limiting)
GITHUB_TOKEN=your-github-personal-access-token-here

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloned Workspace Temp Storage (Defaults to system temp if unset)
TEMP_WORKSPACE_DIR=
