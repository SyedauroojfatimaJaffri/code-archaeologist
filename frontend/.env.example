# API
# Base URL of the FastAPI backend (no trailing slash), e.g. https://api.codearchaeologist.dev
VITE_API_BASE_URL=

# Supabase Auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force mock data on/off regardless of VITE_API_BASE_URL.
# Leave unset to auto-detect (mocks are used whenever VITE_API_BASE_URL is empty).
VITE_USE_MOCK_DATA=
